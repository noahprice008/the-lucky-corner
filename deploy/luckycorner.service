[Unit]
Description=The Lucky Corner (demo)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/luckycorner/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3100
ExecStart=/usr/bin/node /opt/luckycorner/app/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
